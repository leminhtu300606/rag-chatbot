# Copy thành .env rồi sửa (KHÔNG commit .env)
# cp .env.example .env

# ── Model & phần cứng ──
OLLAMA_BASE=http://ollama:11434
LLM_MODEL=qwen2.5:1.5b
LLM_BACKEND=ollama
DEVICE=cpu
# EMBED_MODEL=   # để trống = tự chọn theo DEVICE

# ── Auth (GĐ2) ──
AUTH_ENABLED=false
AUTH_TOKEN_TTL_SECONDS=43200
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# ── Rate limit & quota ──
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
CHAT_DAILY_LIMIT=200
MAX_UPLOAD_MB_PER_USER=500

# ── Cache (GĐ4) ──
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ITEMS=1000

# ── Log & cleanup (GĐ3) ──
LOG_CHAT_JSONL=true
CLEANUP_INTERVAL_SECONDS=3600

# ── ClamAV (tùy chọn, cần clamav-daemon chạy ở CLAMAV_HOST:CLAMAV_PORT) ──
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=false
